# Copy to .env for local development. Never commit real values.

# Supabase: server-side (used by SSR + server functions)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Service role key: server only, needed to write listings and scrape runs
SUPABASE_SERVICE_ROLE_KEY=

# Supabase: browser copies (inlined by Vite at build time)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# TinyFish web agent that scrapes listings
TINYFISH_API_KEY=
# If set, the refresh hook only accepts `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=

# Yard Guide AI: any OpenAI-compatible API
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=gpt-5-mini
# Legacy: only used when OPENAI_API_KEY is empty (Lovable AI gateway)
# LOVABLE_API_KEY=

# Show the clearly marked sample Lagos/Yaba listings (default true)
SHOW_SAMPLE_LISTINGS=true

# Build target for self-hosting (Render, any Node host)
NITRO_PRESET=node-server
PORT=3000
